# DATABASE
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/order_db

# CAPASHINO API
CAPASHINO_INTERNAL_URL=https://capashino.dev-2.python-labs.ru
CAPASHINO_API_TOKEN=your_personal_api_token_here

# APPLICATION
DEBUG=true

# Формат: http://<service-name>.<namespace>.svc:<порт>
ORDER_SERVICE_INTERNAL_URL=http://student-system-order-service.student-system-order.svc:8000

# KAFKA
KAFKA_BOOTSTRAP_SERVERS=kafka.kafka.svc.cluster.local:9092
KAFKA_CONSUMER_GROUP_ID=order-service
ORDER_EVENTS_TOPIC=student_system-order.events
SHIPMENT_EVENTS_TOPIC=student_system-shipment.events
OUTBOX_POLL_INTERVAL=1.0
